# Single connection URL used by the API (app/database.py) and notebook 06.
# Local Postgres:
DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/wildfire_db

# Hosted Postgres (e.g. Neon) — note the SSL params baked into the URL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
